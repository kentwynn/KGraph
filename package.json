{
  "name": "@kentwynn/kgraph",
  "version": "0.1.16",
  "description": "Persistent repo intelligence for AI coding assistants.",
  "type": "module",
  "bin": {
    "kgraph": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/cli/index.js",
    "test": "vitest run",
    "kgraph": "tsx src/cli/index.ts",
    "check:artifacts": "node scripts/check-clean-artifacts.mjs",
    "pack:dry": "npm pack --dry-run",
    "release:pack": "npm run build && npm test && npm run check:artifacts && npm pack"
  },
  "keywords": [
    "ai",
    "code-intelligence",
    "cli",
    "repository",
    "context"
  ],
  "author": "Kent Wynn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kentwynn/KGraph.git"
  },
  "bugs": {
    "url": "https://github.com/kentwynn/KGraph/issues"
  },
  "homepage": "https://github.com/kentwynn/KGraph#readme",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "figlet": "^1.11.0",
    "typescript": "^5.9.3",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
