{
  "name": "@kentwynn/kgraph",
  "version": "0.2.14",
  "description": "Persistent repo intelligence for AI coding assistants.",
  "type": "module",
  "bin": {
    "kgraph": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "postbuild": "node -e \"try{require('child_process').execSync('chmod +x dist/cli/index.js')}catch{}\"",
    "test": "vitest run",
    "kgraph": "tsx src/cli/index.ts",
    "check:artifacts": "node scripts/check-clean-artifacts.mjs",
    "pack:dry": "npm pack --dry-run",
    "release:pack": "npm run build && npm test && npm run check:artifacts && npm pack",
    "release": "release-it",
    "release:minor": "release-it minor",
    "release:major": "release-it major"
  },
  "keywords": [
    "ai",
    "code-intelligence",
    "cli",
    "repository",
    "context"
  ],
  "author": "Kent Wynn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kentwynn/KGraph.git"
  },
  "bugs": {
    "url": "https://github.com/kentwynn/KGraph/issues"
  },
  "homepage": "https://github.com/kentwynn/KGraph#readme",
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@tree-sitter-grammars/tree-sitter-kotlin": "^1.1.0",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "figlet": "^1.11.0",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "typescript": "^5.9.3",
    "web-tree-sitter": "^0.26.8",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/node": "^20.17.10",
    "release-it": "^20.0.1",
    "tsx": "^4.19.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
